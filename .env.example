# ================================================================
# SERVIDOR BFF: estas variáveis nunca podem usar o prefixo VITE_.
# Copie este arquivo para .env e preencha os valores do ambiente.
# ================================================================

# API MAG (somente no servidor)
MAG_API_HOST=https://apis-hmg.magcap.com.br
MAG_API_TOKEN_URL=https://apis-hmg.magcap.com.br/connect/token
MAG_API_CLIENT_ID=usr_cap_api_prd
MAG_API_CLIENT_SECRET=defina-a-credencial-do-ambiente
MAG_API_SCOPE=cap.api

# Integração opcional usada pela tela de produtos
OUTSYSTEMS_BASE_URL=

# Opção temporária de contingência: token estático somente no servidor.
MAG_API_ACCESS_TOKEN=

# Banco local usado pelo BFF para registrar propostas
BFF_DATABASE_PATH=./data/traditional-sale.sqlite

# Servidor BFF
BFF_HOST=127.0.0.1
BFF_PORT=3000
BFF_CORS_ORIGIN=http://localhost:5173
BFF_REQUEST_TIMEOUT_MS=30000
BFF_MAX_BODY_BYTES=2097152

# Desenvolvimento local (o dev:all troca automaticamente se a porta estiver ocupada)
FRONTEND_PORT=5173
