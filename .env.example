# Hosts das integrações
VITE_API_BASE_URL=https://apis-hmg.magcap.com.br
# Opcional: use quando o OAuth estiver em um host diferente da API principal.
VITE_AUTH_BASE_URL=https://apis-hmg.magcap.com.br
VITE_OUTSYSTEMS_BASE_URL=https://outsystemshmg.simple2u.com.br/VendaAssistidaCAP_CS

# OAuth para gerar o token Sensedia. Estes valores sao incluidos no bundle do navegador.
VITE_AUTH_CLIENT_ID=usr_cap_api_hmg
VITE_AUTH_CLIENT_SECRET=defina-a-credencial-do-ambiente
VITE_AUTH_SCOPE=cap.api

# Token temporario usado quando @Mag:sensedia_token nao estiver no localStorage.
VITE_API_TOKEN=

# Configurações do Supabase
VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_ANON_KEY=sua-anon-key-aqui
